{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Sandbox: RunSandbox",
            "request": "launch",
            "mainClass": "sandbox.RunSandbox",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Run current file",
            "request": "launch",
            "mainClass": "${file}",
